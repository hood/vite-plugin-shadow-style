{
  "name": "vite-plugin-shadow-style",
  "version": "2.0.0",
  "description": "A vite plugin to inject css into web components' shadow dom",
  "author": "Andrea Cappuccio <hood@null.net>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/hood/vite-plugin-shadow-style.git"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "webcomponents",
    "css",
    "style",
    "shadow-dom"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepare": "tsc -p .",
    "test": "tsc -p . && node --test"
  },
  "peerDependencies": {
    "vite": ">=4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
