{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ESNext"],
    "types": ["node"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "rootDir": "src",
    "outDir": "dist",
    "removeComments": true
  },
  "include": ["./src/**/*"]
}
